# ---------------------------------------------------------------------------
# SalesTrace Ethiopia — web application configuration
# ---------------------------------------------------------------------------

# The browser talks to the web app only. The app proxies /api/* and /r/* to the API,
# which keeps the session cookie first-party and the tracking links on your domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the Next.js server forwards /api/* and /r/* requests (server-side only).
API_INTERNAL_URL=http://localhost:4000

# The public base URL of the application, used to build tracking links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name shown in the interface.
NEXT_PUBLIC_APP_NAME=SalesTrace Ethiopia
