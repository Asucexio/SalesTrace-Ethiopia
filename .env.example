# ---------------------------------------------------------------------------
# SalesTrace Ethiopia — environment configuration
#
# Copy this file to `.env` and fill in the values. Never commit a real `.env`.
# The API refuses to start when a required variable is missing or malformed;
# it prints the variable name and the expected format, never a value.
# ---------------------------------------------------------------------------

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Supabase connection string (Project Settings → Database → Connection string).
# The API connects as the database owner but switches to the `salestrace_app`
# role inside every transaction so that Row Level Security always applies.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Authentication -------------------------------------------------------
# `supabase` for production, `local` for development, CI and the E2E suite.
# The local provider hashes passwords with scrypt and issues its own sessions.
# The API refuses to start with AUTH_MODE=local when NODE_ENV=production.
AUTH_MODE=local
SESSION_COOKIE_NAME=st_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# --- Supabase (required when AUTH_MODE=supabase) --------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY= 
SUPABASE_SERVICE_ROLE_KEY= 
# --- Public URLs ----------------------------------------------------------
# The public base URL of the web app. Tracking links are built from it:
#   https://<PUBLIC_BASE_URL>/r/<code>
PUBLIC_BASE_URL=http://localhost:3000
# The public base URL of the API (used in the OpenAPI document).
API_BASE_URL=http://localhost:4000

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API directly. The web
# app proxies /api/* so the browser usually only needs the app's own origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Privacy --------------------------------------------------------------
# Salt used to hash visitor IP addresses. Changing it invalidates the existing
# fingerprints. Use a long random value; keep it out of version control.
IP_HASH_PEPPER= 

# --- Tracking -------------------------------------------------------------
# Click events within this window are coalesced instead of stored separately.
TRACKING_DEDUPE_WINDOW_SECONDS=30
# Append ?st_ref=<code> to the tracking destination so the brand's site can
# echo the referral code back into the order — the cookie-less attribution path.
TRACKING_PROPAGATE_REF_PARAM=true

# --- Uploads --------------------------------------------------------------
# Maximum size of an uploaded order CSV (bytes).
MAX_UPLOAD_BYTES=10485760
